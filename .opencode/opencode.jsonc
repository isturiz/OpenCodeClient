{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "xcodebuildmcp": {
        "type": "local",
        "command": ["npx", "-y", "xcodebuildmcp@latest", "mcp"],
        "disabled": false,
        "environment": {
          "XCODEBUILDMCP_ENABLED_WORKFLOWS": "simulator,ui-automation,debugging,logging"
        }
      }
    }
  }
}
